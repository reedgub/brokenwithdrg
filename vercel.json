{
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sponsors",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
